# System 1: arkos4clone
SYSNAME="arkos4clone"
# Source the binary is built from (must match the distro's own ES fork):
SRC_DIR="EmulationStation-fcamod-lcdyk"   # lcdyk0517/EmulationStation-fcamod @ dev
# Unique string in the distro's own ES binary. The installer refuses unless the
# ES already on the device contains it, so this binary only ever replaces its own fork.
FINGERPRINT="ARKOS4CLONE SETTINGS"
