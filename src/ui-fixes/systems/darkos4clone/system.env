# dArkOS4Clone (lcdyk0517/arkos4clone on a dArkOS image). Same ES as ArkOS4Clone: clone_support.sh syncs rootfs/dArkOS
# (which carries lcdyk's emulationstation) into both flavours; the ArkOS flavour only layers rootfs/ArkOS on top, with no ES.
SYSNAME="dArkOS4Clone"
SRC_DIR="EmulationStation-fcamod-lcdyk"   # lcdyk0517/EmulationStation-fcamod @ dev
FINGERPRINT="ARKOS4CLONE SETTINGS"
EXCLUDE=""
